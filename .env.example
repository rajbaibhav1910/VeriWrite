# Copy to .env.local for local development. Never commit real values.

# Base URL of the VeriWrite API. Left empty, the app runs entirely client-side
# against the bundled local engines and every tool page shows its local mode.
VITE_API_BASE_URL=

# Publishable Stripe price ids, read by the pricing page to open a checkout session.
# These are the public price identifiers from the Stripe dashboard, not secrets; a
# checkout still requires VITE_API_BASE_URL, and the secret keys below stay server-side.
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_ANNUAL=
VITE_STRIPE_PRICE_TEAM_MONTHLY=
VITE_STRIPE_PRICE_TEAM_ANNUAL=

# Server-side only (Express/FastAPI). Detection secrets and model endpoints must
# never be exposed to the browser, so the frontend has no key variables at all.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DETECTION_SERVICE_URL=
DETECTION_SERVICE_TOKEN=
CORS_ALLOWED_ORIGINS=
